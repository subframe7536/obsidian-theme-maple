{
  "name": "maple",
  "version": "0.8.34",
  "type": "module",
  "author": "subframe7536",
  "description": "elegant theme for Obsidian",
  "scripts": {
    "dev": "bun scripts/compile.ts src/dev.scss",
    "build": "bun scripts/compile.ts --build && bun scripts/move.ts",
    "test": "bun scripts/compile.ts --test src/snippets/test.scss",
    "replace-version": "bun scripts/version.ts && bun run build",
    "release": "bumpp -x \"npm run replace-version\" --all"
  },
  "keywords": [
    "Obsidian"
  ],
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/bi": "^1.2.6",
    "@iconify-json/lucide": "^1.2.65",
    "@iconify-json/tabler": "^1.2.22",
    "bumpp": "^10.2.3",
    "bun-types": "^1.2.21",
    "sass": "^1.91.0"
  }
}